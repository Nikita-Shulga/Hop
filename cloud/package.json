{
  "name": "localview-cloud",
  "private": true,
  "description": "Local View connection server: introduces viewers to computers by ID and serves the viewer page.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler dev --port 8787",
    "deploy": "node build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.150.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
